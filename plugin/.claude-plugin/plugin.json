{
  "name": "hq",
  "displayName": "Tranquility Knowledge Base",
  "version": "1.1.0",
  "description": "Reports become HTML pages and push themselves to your Knowledge Base at hq.tranquilitybase.dev; share with everyone at your company or with anyone by link; the hub's tools for the agent.",
  "author": {
    "name": "Robert Nowell",
    "url": "https://tranquilitybase.dev"
  },
  "homepage": "https://github.com/robertnowell/tranquility-plugins",
