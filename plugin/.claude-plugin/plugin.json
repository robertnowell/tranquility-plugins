  "license": "MIT",
  "keywords": [
    "reports",
    "sharing",
    "knowledge-base",
    "html"
  ],
  "skills": [
    "./skills/"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "hq": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"
      ]
    }
  }
}
